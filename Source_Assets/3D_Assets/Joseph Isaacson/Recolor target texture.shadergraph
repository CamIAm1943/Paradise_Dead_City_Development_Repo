{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "11003b135c07444495691c5ec1e51749",
    "m_Title": "IF else statement",
    "m_Content": "IF Color protect override   -> Do another pass of extracting a color and overlapping its old color. This use case was made for a model with overlapping geo that had the team color bleed over to something that wasn't supposed to be bled onto.",
