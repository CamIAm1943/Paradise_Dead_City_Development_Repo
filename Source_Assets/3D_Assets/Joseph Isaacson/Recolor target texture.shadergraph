{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "bdb9825b68894efe9cec4e407e036834",
    "m_Title": "Recolor target texture notes",
    "m_Content": "Most important 2 nodes here are color mask and blend nodes.\nColor mask takes the original area and creates a mask or selection greyscale image and outputs it based on a range of color and a fuziness / bleed input. ",
    "m_TextSize": 0,
